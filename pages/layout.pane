title Layout
col
  pad 16
  gap 12
  fnt 22
  fg 235 240 255
  txt Layout
  fnt 13
  fg 190 205 230
  txt A row shares its width equally.
  row
    gap 6
    box
      bg 30 50 90
      pad 6
      txt one
    end
    box
      bg 30 50 90
      pad 6
      txt two
    end
    box
      bg 30 50 90
      pad 6
      txt three
    end
  end
  txt grow sets the shares: 1, 2 and 3.
  row
    gap 6
    box
      bg 30 70 60
      pad 6
      grow 1
      txt 1
    end
    box
      bg 30 70 60
      pad 6
      grow 2
      txt 2
    end
    box
      bg 30 70 60
      pad 6
      grow 3
      txt 3
    end
  end
  txt A fixed 120, a quarter, and the rest.
  row
    gap 6
    box 120
      bg 80 50 30
      pad 6
      txt 120
    end
    box 25%
      bg 80 50 30
      pad 6
      txt 25%
    end
    box
      bg 80 50 30
      pad 6
      txt rest
    end
  end
  txt just keeps natural widths and spreads the spare space.
  row
    gap 6
    just between
    box
      bg 70 40 80
      pad 6
      txt left
    end
    box
      bg 70 40 80
      pad 6
      txt middle
    end
    box
      bg 70 40 80
      pad 6
      txt right
    end
  end
  txt align centers children across a row.
  row
    gap 6
    align center
    h 100
    bg 12 20 36
    box
      bg 30 50 90
      pad 6
      txt short
    end
    box
      bg 30 50 90
      pad 6
      txt taller, because this text wraps when the box is narrow
    end
  end
  txt minw and maxw bound a share.
  row
    gap 6
    box
      bg 30 70 60
      pad 6
      maxw 90
      txt max 90
    end
    box
      bg 30 70 60
      pad 6
      minw 200
      txt min 200
    end
    box
      bg 30 70 60
      pad 6
      txt free
    end
  end
  lnk Back to the start page home
end
